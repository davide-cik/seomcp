{
  "name": "@contentisking/seomcp",
  "version": "0.1.27",
  "description": "Server MCP open source per SEO, GEO e AEO: Search Console, Analytics 4, Bing Webmaster, Core Web Vitals, analisi di citabilità per i motori AI e validatore schema.org. Sola lettura, credenziali sul tuo computer.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "seo",
    "ai-search",
    "json-ld",
    "structured-data",
    "schema-org",
    "llms-txt",
    "aeo",
    "geo",
    "search-console",
    "bing-webmaster",
    "ga4",
    "google-analytics",
    "pagespeed",
    "core-web-vitals",
    "claude",
    "chatgpt",
    "codex",
    "copilot",
    "gemini",
    "mistral",
    "indexnow"
  ],
  "license": "MIT",
  "author": "Content is King Srl (https://contentisking.guru)",
  "homepage": "https://seomcp.contentisking.guru",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davide-cik/seomcp.git"
  },
  "bugs": "https://github.com/davide-cik/seomcp/issues",
  "mcpName": "guru.contentisking/seomcp",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "seomcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "dev": "tsx src/cli.ts",
    "doctor": "tsx src/cli.ts doctor",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "schema:update": "node scripts/build-schema-vocab.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@googleapis/analyticsadmin": "^22.0.1",
    "@googleapis/analyticsdata": "^10.1.0",
    "@googleapis/chromeuxreport": "^12.0.1",
    "@googleapis/pagespeedonline": "^10.0.1",
    "@googleapis/searchconsole": "^11.0.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "domhandler": "^6.0.1",
    "domutils": "^4.0.2",
    "google-auth-library": "^11.1.0",
    "htmlparser2": "^12.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
