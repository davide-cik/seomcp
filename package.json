{
  "name": "@contentisking/seomcp",
  "version": "0.1.6",
  "description": "Server MCP open source per Google Search Console e Bing Webmaster Tools, per Claude e ChatGPT. Le credenziali restano sul tuo computer.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "seo",
    "search-console",
    "bing-webmaster",
    "claude",
    "chatgpt",
    "codex",
    "indexnow"
  ],
  "license": "MIT",
  "author": "Content is King Srl (https://contentisking.guru)",
  "homepage": "https://seomcp.contentisking.guru",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davide-cik/seomcp.git"
  },
  "bugs": "https://github.com/davide-cik/seomcp/issues",
  "mcpName": "guru.contentisking/seomcp",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "bin": {
    "seomcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "dev": "tsx src/cli.ts",
    "doctor": "tsx src/cli.ts doctor",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@googleapis/searchconsole": "^11.0.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "google-auth-library": "^11.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
